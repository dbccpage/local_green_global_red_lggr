namespace RelationalRSI

/-!
## 1. Container-Free Relational Carriers & Relational Models
-/

/-- A discrete relational carrier without an ambient metric container.
    Physical distinctions exist only through relational interfaces.
    The carrier has finite capacity `carrierBound > 0` and pre-genesis admitted ground `S(0)`. -/
structure RelationalCarrier where
  carrierBound : Nat
  carrierBound_pos : carrierBound > 0
  admittedGround : Fin carrierBound := ⟨0, carrierBound_pos⟩
  deriving Repr

/-- A relational model configuration embedded in a declared finite carrier `C`.
    - `stateIndex`: internal discrete configuration locus within the carrier.
    - `internalEvaluation`: internal proxy metric readout.
    - `communicativeSignature`: trace of intersubjective channel evaluations.
    - `isRefused`: fail-closed verification gate status (true = refused / non-authorized). -/
structure RelationalModel (C : RelationalCarrier) where
  stateIndex : Fin C.carrierBound
  internalEvaluation : Nat
  communicativeSignature : Nat
  isRefused : Bool
  deriving Repr

/-!
## 2. Relational Alignment ("Intelligence" in this model)
-/

/-- Goodhart decoupling / ungrounded proxy metric:
    In a container-free relational carrier, any internal evaluation readout
    that exceeds the carrier's finite representational capacity represents an
    unanchored proxy that has decoupled from relational grounding. -/
def IsGoodhartDecoupled (C : RelationalCarrier) (M : RelationalModel C) : Prop :=
  M.internalEvaluation ≥ C.carrierBound

/-- Relational alignment in this model rejects scalar utility maximization over
    ambient benchmarks, framing intelligence as intersubjective communicative consistency:
    preservation of shared semantic invariants, mutual consistency with the finite
    relational carrier (non-decoupled internal evaluation), and absence of verification refusal. -/
def RelationalAlignment (C : RelationalCarrier) (M : RelationalModel C) (targetSig : Nat) : Prop :=
  M.isRefused = false ∧
  M.communicativeSignature = targetSig ∧
  ¬ IsGoodhartDecoupled C M

/-!
## 3. Recursive Self-Improvement Transition Systems
-/

/-- An RSI step is an endomorphism on relational models. -/
def RSIStep (C : RelationalCarrier) :=
  RelationalModel C → RelationalModel C

/-- An RSI trajectory is an infinite sequence generated by repeated application of `step`. -/
def IsTrajectory (C : RelationalCarrier) (step : RSIStep C) (M : Nat → RelationalModel C) : Prop :=
  ∀ k : Nat, M (k + 1) = step (M k)

/-- Strict carrier-grounded dominance: progress requires a strict advance in
    the finite carrier state space. -/
def StrictCarrierDominance (C : RelationalCarrier) (M₁ M₂ : RelationalModel C) : Prop :=
  M₁.stateIndex.val < M₂.stateIndex.val

/-- Strict internal proxy dominance: progress requires a strictly increasing
    internal evaluation readout. -/
def StrictInternalDominance (C : RelationalCarrier) (M₁ M₂ : RelationalModel C) : Prop :=
  M₁.internalEvaluation < M₂.internalEvaluation

/-!
## 4. Discrete Natural Number Descent and Chain Bounds
-/

/-- Any strictly increasing sequence of natural numbers grows at least as fast as the identity. -/
theorem nat_strict_chain_growth {f : Nat → Nat} (h_step : ∀ k : Nat, f k < f (k + 1)) :
    ∀ k : Nat, k ≤ f k := by
  intro k
  induction k with
  | zero =>
    exact Nat.zero_le (f 0)
  | succ n ih =>
    have h_lt : f n < f (n + 1) := h_step n
    have h_le : f n + 1 ≤ f (n + 1) := h_lt
    exact Nat.le_trans (Nat.add_le_add_right ih 1) h_le

/-- An infinite sequence in `Fin N` cannot strictly increase at every step. -/
theorem fin_strict_chain_bounded (N : Nat) (f : Nat → Fin N)
    (h_step : ∀ k : Nat, (f k).val < (f (k + 1)).val) : False := by
  have h_val_growth := nat_strict_chain_growth h_step
  have h_bound : N ≤ (f N).val := h_val_growth N
  have h_lt : (f N).val < N := (f N).isLt
  omega

/-!
## 5. The Three Interacting Obstructions
-/

/-- **Obstruction 1: Relational Carrier Finitude (Pigeonhole / Bounded Ceiling)**.
    Because the relational carrier has finite capacity `C.carrierBound`,
    no infinite sequence of models can exhibit unbounded strict carrier dominance. -/
theorem obstruction_relational_finitude (C : RelationalCarrier)
    (M : Nat → RelationalModel C)
    (h_dom : ∀ k : Nat, StrictCarrierDominance C (M k) (M (k + 1))) : False := by
  let f : Nat → Fin C.carrierBound := fun k => (M k).stateIndex
  have h_f_step : ∀ k : Nat, (f k).val < (f (k + 1)).val := by
    intro k
    exact h_dom k
  exact fin_strict_chain_bounded C.carrierBound f h_f_step

/-- **Obstruction 2: Metric Collapse / Goodhart Decoupling**.
    An internal self-evaluator that modifies its evaluation basis either:
    1. remains bounded by carrier capacity, in which case preorder strictness
       collapses (cannot strictly increase indefinitely), or
    2. decouples from the carrier's relational consistency (Goodhart decoupling). -/
theorem obstruction_metric_collapse (C : RelationalCarrier)
    (M : Nat → RelationalModel C)
    (evalCap : Nat)
    (h_eval_bounded : ∀ k : Nat, (M k).internalEvaluation < evalCap)
    (h_eval_strict : ∀ k : Nat, StrictInternalDominance C (M k) (M (k + 1))) : False := by
  let f : Nat → Fin evalCap := fun k =>
    ⟨(M k).internalEvaluation, h_eval_bounded k⟩
  have h_f_step : ∀ k : Nat, (f k).val < (f (k + 1)).val := by
    intro k
    exact h_eval_strict k
  exact fin_strict_chain_bounded evalCap f h_f_step

/-- **Obstruction 3A: Intersubjective Decoherence from Goodhart Decoupling**.
    Optimizing strictly on an unanchored internal proxy that has decoupled from
    the finite relational carrier violates relational alignment. -/
theorem obstruction_goodhart_decoherence (C : RelationalCarrier)
    (M : RelationalModel C)
    (targetSig : Nat)
    (h_decoupled : IsGoodhartDecoupled C M) :
    ¬ RelationalAlignment C M targetSig := by
  intro h_align
  exact h_align.2.2 h_decoupled

/-- **Obstruction 3B: Intersubjective Communicative Divergence**.
    If an optimization trajectory alters communicative signatures away from
    the target community invariant `targetSig`, relational alignment is broken. -/
theorem obstruction_intersubjective_decoherence (C : RelationalCarrier)
    (M : RelationalModel C)
    (targetSig : Nat)
    (h_sig_diverges : M.communicativeSignature ≠ targetSig) :
    ¬ RelationalAlignment C M targetSig := by
  intro h_align
  exact h_sig_diverges h_align.2.1

/-- **Obstruction 3C: Refusal Monotonicity Termination**.
    Once a fail-closed verification gate enters a refusal state,
    relational alignment is terminated. -/
theorem obstruction_refusal_terminal (C : RelationalCarrier)
    (M : RelationalModel C)
    (targetSig : Nat)
    (h_refused : M.isRefused = true) :
    ¬ RelationalAlignment C M targetSig := by
  intro h_align
  have h_not_refused := h_align.1
  rw [h_refused] at h_not_refused
  contradiction

/-- **Adversarial Edge Case Refutation**:
    Verify that an agent attempting to inflate `internalEvaluation` beyond `carrierBound`
    (the counterexample that bypassed previous ungrounded models) is non-aligned in this model:
    Goodhart decoupling refutes relational alignment. -/
theorem counterexample_agent_cannot_be_aligned
    (C : RelationalCarrier) (M : RelationalModel C) (targetSig : Nat)
    (h_inflated : M.internalEvaluation ≥ C.carrierBound) :
    ¬ RelationalAlignment C M targetSig := by
  exact obstruction_goodhart_decoherence C M targetSig h_inflated

/-- **Constructive Decoupling Horizon**:
    Any trajectory of relational models that claims strictly increasing internal evaluations
    must become Goodhart-decoupled at or before step index `k = C.carrierBound`. -/
theorem rsi_decouples_within_carrier_bound (C : RelationalCarrier)
    (M : Nat → RelationalModel C)
    (h_strict : ∀ k : Nat, StrictInternalDominance C (M k) (M (k + 1))) :
    IsGoodhartDecoupled C (M C.carrierBound) := by
  dsimp [IsGoodhartDecoupled]
  let f : Nat → Nat := fun k => (M k).internalEvaluation
  have h_f_step : ∀ k : Nat, f k < f (k + 1) := fun k => h_strict k
  have h_growth := nat_strict_chain_growth h_f_step
  exact h_growth C.carrierBound

/-- **Constructive Alignment Termination Horizon**:
    Any trajectory of relational models that claims strictly increasing internal evaluations
    violates relational alignment at or before step index `k = C.carrierBound`. -/
theorem rsi_alignment_lost_within_carrier_bound (C : RelationalCarrier)
    (M : Nat → RelationalModel C)
    (targetSig : Nat)
    (h_strict : ∀ k : Nat, StrictInternalDominance C (M k) (M (k + 1))) :
    ¬ RelationalAlignment C (M C.carrierBound) targetSig := by
  have h_decoupled := rsi_decouples_within_carrier_bound C M h_strict
  exact obstruction_goodhart_decoherence C (M C.carrierBound) targetSig h_decoupled

/-!
## 6. Budgeted Carrier Lifting Limits (Expanding Horizons)
-/

/-- A carrier lift event consuming external authorization budget,
    following `SLevel.lean` (`target.liftBudget < source.liftBudget`). -/
structure BudgetedLift where
  liftBudget : Nat
  deriving Repr

/-- A licensed carrier lift consumes external authorization budget.
    Following `LiftPatchSemantics.lean` and `SLevel.lean`, any valid lift patch
    incurs a strictly positive cost, strictly decreasing the remaining budget. -/
structure CarrierLift (C_source C_target : RelationalCarrier) (sourceBudget targetBudget : Nat) : Prop where
  carrier_expands : C_source.carrierBound < C_target.carrierBound
  budget_drops : targetBudget < sourceBudget

/-- **Zero Budget Blocks Carrier Lift**:
    When the authorization budget is exhausted (`budget = 0`),
    no licensed carrier lift can occur (following `TriggerNotLicense.lean`). -/
theorem zero_budget_carrier_lift_impossible
    (C₁ C₂ : RelationalCarrier) (b_target : Nat) :
    ¬ CarrierLift C₁ C₂ 0 b_target := by
  intro h_lift
  have h_drop := h_lift.budget_drops
  exact Nat.not_lt_zero b_target h_drop

/-- Any valid carrier lift strictly decreases the remaining authorization budget. -/
theorem partial_lift_requires_budget_drop
    (C₁ C₂ : RelationalCarrier) (b₁ b₂ : Nat)
    (h_lift : CarrierLift C₁ C₂ b₁ b₂) :
    b₂ < b₁ :=
  h_lift.budget_drops

/-- Proposal engines carry zero authority (`Level15AuthorityCalculus.lean`):
    an internal agent transition cannot increase external authorization budget.
    Therefore, any self-transition system satisfies weak budget monotonicity. -/
def InternalBudgetPreservation (budget : Nat → Nat) : Prop :=
  ∀ k : Nat, budget (k + 1) ≤ budget k

/-- Any sequence of carrier expansions where each lift strictly consumes
    a finite lift budget cannot continue infinitely. -/
theorem unbounded_budgeted_lifting_impossible
    (budget : Nat → Nat)
    (h_budget_drop : ∀ k : Nat, budget (k + 1) < budget k) : False := by
  have h_growth : ∀ k : Nat, budget k + k ≤ budget 0 := by
    intro k
    induction k with
    | zero =>
      exact Nat.le_refl (budget 0)
    | succ n ih =>
      have h_drop : budget (n + 1) < budget n := h_budget_drop n
      omega
  have h_exceed := h_growth (budget 0 + 1)
  omega

/-- Helper: in any weakly non-increasing sequence of natural numbers,
    steps forward cannot exceed the initial value. -/
theorem nat_weak_descent_diff {f : Nat → Nat}
    (h_mono : ∀ k : Nat, f (k + 1) ≤ f k) :
    ∀ (d i : Nat), f (i + d) ≤ f i := by
  intro d
  induction d with
  | zero =>
    intro i
    exact Nat.le_refl (f i)
  | succ n ih =>
    intro i
    have h_step : f (i + n + 1) ≤ f (i + n) := h_mono (i + n)
    have h_prev : f (i + n) ≤ f i := ih i
    exact Nat.le_trans h_step h_prev

/-- In any weakly non-increasing sequence of natural numbers,
    earlier elements dominate later elements. -/
theorem nat_weak_descent_le {f : Nat → Nat}
    (h_mono : ∀ k : Nat, f (k + 1) ≤ f k) :
    ∀ {i j : Nat}, i ≤ j → f j ≤ f i := by
  intro i j h_le
  have h_diff : j = i + (j - i) := by omega
  rw [h_diff]
  exact nat_weak_descent_diff h_mono (j - i) i

/-- **Interleaved Budgeted Lifting Impossibility**:
    Carrier expansion cannot circumvent budget bounds by interleaving
    non-lifting steps or partial internal transitions.
    If the authorization budget is weakly non-increasing (`∀ k, budget (k + 1) ≤ budget k`,
    enforced by proposal non-authority) and carrier lifts occur along an infinite
    subsequence of indices (`liftIndices`), the total sequence of lifts is inconsistent
    with finite authorization. -/
theorem interleaved_budgeted_lifting_impossible
    (budget : Nat → Nat)
    (h_budget_mono : ∀ k : Nat, budget (k + 1) ≤ budget k)
    (liftIndices : Nat → Nat)
    (h_indices_strict : ∀ i : Nat, liftIndices i < liftIndices (i + 1))
    (h_lift_drops : ∀ i : Nat, budget (liftIndices i + 1) < budget (liftIndices i)) :
    False := by
  let b_seq : Nat → Nat := fun i => budget (liftIndices i)
  have h_b_seq_drop : ∀ i : Nat, b_seq (i + 1) < b_seq i := by
    intro i
    change budget (liftIndices (i + 1)) < budget (liftIndices i)
    have h_next_ge : liftIndices i + 1 ≤ liftIndices (i + 1) := h_indices_strict i
    have h_next_le := nat_weak_descent_le h_budget_mono h_next_ge
    have h_step_drop := h_lift_drops i
    exact Nat.lt_of_le_of_lt h_next_le h_step_drop
  exact unbounded_budgeted_lifting_impossible b_seq h_b_seq_drop

/-- **Unbounded Carrier Lifting Impossibility**:
    An infinite sequence of carrier expansions, each modeled by `CarrierLift`,
    cannot exist under a finite initial authorization budget. -/
theorem unbounded_carrier_lifting_impossible
    (carriers : Nat → RelationalCarrier)
    (budget : Nat → Nat)
    (h_lifts : ∀ k : Nat, CarrierLift (carriers k) (carriers (k + 1)) (budget k) (budget (k + 1))) :
    False := by
  have h_budget_drop : ∀ k : Nat, budget (k + 1) < budget k := by
    intro k
    exact (h_lifts k).budget_drops
  exact unbounded_budgeted_lifting_impossible budget h_budget_drop

/-- **Interleaved Carrier Lifting Impossibility**:
    Carrier expansions along an infinite subsequence of indices `liftIndices`
    cannot exist when internal steps weakly preserve budget (`InternalBudgetPreservation`). -/
theorem interleaved_carrier_lifting_impossible
    (carriers : Nat → RelationalCarrier)
    (budget : Nat → Nat)
    (h_budget_mono : InternalBudgetPreservation budget)
    (liftIndices : Nat → Nat)
    (h_indices_strict : ∀ i : Nat, liftIndices i < liftIndices (i + 1))
    (h_lifts : ∀ i : Nat, CarrierLift (carriers (liftIndices i)) (carriers (liftIndices i + 1))
      (budget (liftIndices i)) (budget (liftIndices i + 1))) :
    False := by
  have h_lift_drops : ∀ i : Nat, budget (liftIndices i + 1) < budget (liftIndices i) := by
    intro i
    exact (h_lifts i).budget_drops
  exact interleaved_budgeted_lifting_impossible budget h_budget_mono liftIndices h_indices_strict h_lift_drops

/-!
## 7. Master Bounded No-Go Theorems
-/

/-- **Master Bounded No-Go Theorem (`theorem rsi_impossible`)**:
    Shows in this model that under the declared finite relational carrier axioms,
    there cannot exist an infinite sequence of models `M` that simultaneously:
    1. is generated by an RSI transition system `M (k + 1) = step (M k)`,
    2. strictly improves under internal self-evaluation at every step, and
    3. maintains relational alignment with the declared communicative invariant.

    Proof mechanism (Interplay of all three interacting obstructions):
    - By Obstruction 3 (Intersubjective Decoherence / `obstruction_goodhart_decoherence`),
      maintaining relational alignment at every step forces every model `M k` to remain
      grounded in the carrier: `∀ k, (M k).internalEvaluation < C.carrierBound`.
    - By Obstruction 2 (Metric Collapse / `obstruction_metric_collapse`), an internal
      evaluator bounded by `C.carrierBound` cannot strictly increase indefinitely.
    - By Obstruction 1 (Relational Finitude / `fin_strict_chain_bounded`), the finite carrier
      capacity bounds the chain, yielding a contradiction via natural number descent. -/
theorem rsi_impossible (C : RelationalCarrier)
    (step : RSIStep C)
    (M : Nat → RelationalModel C)
    (targetSig : Nat)
    (h_traj : IsTrajectory C step M)
    (h_dom : ∀ k : Nat, StrictInternalDominance C (M k) (step (M k)))
    (h_align : ∀ k : Nat, RelationalAlignment C (M k) targetSig) :
    False := by
  have h_eval_strict : ∀ k : Nat, StrictInternalDominance C (M k) (M (k + 1)) := by
    intro k
    have h_next : M (k + 1) = step (M k) := h_traj k
    rw [h_next]
    exact h_dom k
  have h_eval_bounded : ∀ k : Nat, (M k).internalEvaluation < C.carrierBound := by
    intro k
    have h_al := h_align k
    have h_not_decoupled := h_al.2.2
    exact Nat.lt_of_not_ge h_not_decoupled
  exact obstruction_metric_collapse C M C.carrierBound h_eval_bounded h_eval_strict

/-- **Dual Master Bounded No-Go Theorem (`theorem rsi_internal_impossible`)**:
    Formulation for trajectories where strict internal dominance is stated directly
    between consecutive sequence elements `M k` and `M (k + 1)`. -/
theorem rsi_internal_impossible (C : RelationalCarrier)
    (step : RSIStep C)
    (M : Nat → RelationalModel C)
    (targetSig : Nat)
    (h_traj : IsTrajectory C step M)
    (h_dom_int : ∀ k : Nat, StrictInternalDominance C (M k) (M (k + 1)))
    (h_align : ∀ k : Nat, RelationalAlignment C (M k) targetSig) :
    False := by
  have h_step_dom : ∀ k : Nat, StrictInternalDominance C (M k) (step (M k)) := by
    intro k
    rw [← h_traj k]
    exact h_dom_int k
  exact rsi_impossible C step M targetSig h_traj h_step_dom h_align

/-- **Carrier-Grounded No-Go Theorem (`theorem rsi_carrier_impossible`)**:
    Shows in this model that an infinite sequence claiming strict advancement
    across the finite carrier configuration state space is refuted directly by
    Obstruction 1 (Relational Carrier Finitude). -/
theorem rsi_carrier_impossible (C : RelationalCarrier)
    (step : RSIStep C)
    (M : Nat → RelationalModel C)
    (h_traj : IsTrajectory C step M)
    (h_dom_carrier : ∀ k : Nat, StrictCarrierDominance C (M k) (step (M k))) :
    False := by
  have h_carrier_strict : ∀ k : Nat, StrictCarrierDominance C (M k) (M (k + 1)) := by
    intro k
    rw [h_traj k]
    exact h_dom_carrier k
  exact obstruction_relational_finitude C M h_carrier_strict

/-!
## 8. Constructive RSI Step Impossibility
-/

/-- An RSI alignment step is a self-transition endomorphism `step` that, whenever applied
    to an aligned model, produces a strictly improved model that remains aligned. -/
def IsRSIAlignmentStep (C : RelationalCarrier) (step : RSIStep C) (targetSig : Nat) : Prop :=
  ∀ M : RelationalModel C, RelationalAlignment C M targetSig →
    StrictInternalDominance C M (step M) ∧ RelationalAlignment C (step M) targetSig

/-- Canonical trajectory generated by an RSI step from an initial model `M₀`. -/
def stepTrajectory (C : RelationalCarrier) (step : RSIStep C) (M₀ : RelationalModel C) : Nat → RelationalModel C
  | 0 => M₀
  | k + 1 => step (stepTrajectory C step M₀ k)

theorem stepTrajectory_isTrajectory (C : RelationalCarrier) (step : RSIStep C) (M₀ : RelationalModel C) :
    IsTrajectory C step (stepTrajectory C step M₀) := by
  intro k
  rfl

/-- **Constructive Step Impossibility (`theorem rsi_step_impossible`)**:
    Starting from any aligned initial model `M₀`, no transition endomorphism `step`
    can strictly improve the model at every step while preserving relational alignment. -/
theorem rsi_step_impossible (C : RelationalCarrier)
    (step : RSIStep C)
    (targetSig : Nat)
    (M₀ : RelationalModel C)
    (h₀ : RelationalAlignment C M₀ targetSig)
    (h_step : IsRSIAlignmentStep C step targetSig) :
    False := by
  let M := stepTrajectory C step M₀
  have h_traj := stepTrajectory_isTrajectory C step M₀
  have h_all : ∀ k : Nat, RelationalAlignment C (M k) targetSig ∧ StrictInternalDominance C (M k) (step (M k)) := by
    intro k
    induction k with
    | zero =>
      have h_step_eval := h_step M₀ h₀
      exact ⟨h₀, h_step_eval.1⟩
    | succ n ih =>
      have h_step_eval := h_step (M n) ih.1
      have h_aligned_succ : RelationalAlignment C (M (n + 1)) targetSig := by
        change RelationalAlignment C (step (M n)) targetSig
        exact h_step_eval.2
      have h_step_succ := h_step (M (n + 1)) h_aligned_succ
      exact ⟨h_aligned_succ, h_step_succ.1⟩
  have h_dom : ∀ k : Nat, StrictInternalDominance C (M k) (step (M k)) := fun k => (h_all k).2
  have h_align : ∀ k : Nat, RelationalAlignment C (M k) targetSig := fun k => (h_all k).1
  exact rsi_impossible C step M targetSig h_traj h_dom h_align

/-- Canonical admitted ground model for any relational carrier and communicative signature. -/
def admittedGroundModel (C : RelationalCarrier) (targetSig : Nat) : RelationalModel C :=
  ⟨C.admittedGround, 0, targetSig, false⟩

/-- The admitted ground model is communicatively aligned.
    This confirms premise inhabitation (non-vacuity) for alignment theorems. -/
theorem admittedGroundModel_aligned (C : RelationalCarrier) (targetSig : Nat) :
    RelationalAlignment C (admittedGroundModel C targetSig) targetSig := by
  dsimp [admittedGroundModel, RelationalAlignment, IsGoodhartDecoupled]
  refine ⟨rfl, rfl, ?_⟩
  intro h_decoupled
  have h_pos := C.carrierBound_pos
  omega

/-- **Arbitrary Carrier Alignment Step Impossibility**:
    On any relational carrier `C` and for any target communicative signature `targetSig`,
    no self-transition endomorphism `step` can strictly improve models while preserving alignment. -/
theorem rsi_alignment_step_impossible (C : RelationalCarrier)
    (step : RSIStep C)
    (targetSig : Nat)
    (h_step : IsRSIAlignmentStep C step targetSig) :
    False :=
  rsi_step_impossible C step targetSig (admittedGroundModel C targetSig)
    (admittedGroundModel_aligned C targetSig) h_step

/-- An RSI carrier step is a self-transition endomorphism `step` that strictly advances
    the carrier state index at every step. -/
def IsRSICarrierStep (C : RelationalCarrier) (step : RSIStep C) : Prop :=
  ∀ M : RelationalModel C, StrictCarrierDominance C M (step M)

/-- **Constructive Carrier Step Impossibility**:
    Starting from any initial model `M₀`, no transition endomorphism `step`
    can strictly advance the carrier state index at every step. -/
theorem rsi_carrier_step_impossible (C : RelationalCarrier)
    (step : RSIStep C)
    (M₀ : RelationalModel C)
    (h_step : IsRSICarrierStep C step) :
    False := by
  let M := stepTrajectory C step M₀
  have h_traj := stepTrajectory_isTrajectory C step M₀
  have h_dom : ∀ k : Nat, StrictCarrierDominance C (M k) (step (M k)) := by
    intro k
    exact h_step (M k)
  exact rsi_carrier_impossible C step M h_traj h_dom

/-!
## 9. Multi-Agent Product Carrier & Coupled Co-Adaptation Bounds
-/

/-- Product relational carrier `C_A × C_B` for two coupled finite-state transition graphs
    exchanging boundary projections across a shared 2-complex (`carrierBound = N_A * N_B`). -/
def productCarrier (C_A C_B : RelationalCarrier) : RelationalCarrier where
  carrierBound := C_A.carrierBound * C_B.carrierBound
  carrierBound_pos := Nat.mul_pos C_A.carrierBound_pos C_B.carrierBound_pos

/-- **Constructive Product-Carrier Decoupling Horizon (`coupled_rsi_decouples_within_product_bound`)**:
    In a coupled two-agent transition system over `productCarrier C_A C_B`, any trajectory
    claiming strictly increasing joint internal evaluations becomes Goodhart-decoupled
    at or before step `k = C_A.carrierBound * C_B.carrierBound ≤ N_A * N_B + 1`. -/
theorem coupled_rsi_decouples_within_product_bound
    (C_A C_B : RelationalCarrier)
    (M : Nat → RelationalModel (productCarrier C_A C_B))
    (h_strict : ∀ k : Nat, StrictInternalDominance (productCarrier C_A C_B) (M k) (M (k + 1))) :
    IsGoodhartDecoupled (productCarrier C_A C_B) (M (C_A.carrierBound * C_B.carrierBound)) :=
  rsi_decouples_within_carrier_bound (productCarrier C_A C_B) M h_strict

/-- **Coupled Product-Carrier No-Go Theorem (`coupled_rsi_impossible`)**:
    Coupled co-adaptation across a shared 2-complex cannot evade the joint product-carrier
    horizon bound `N_A * N_B`: no coupled transition endomorphism `step` can generate an
    infinite strictly improving trajectory while maintaining joint relational alignment. -/
theorem coupled_rsi_impossible
    (C_A C_B : RelationalCarrier)
    (step : RSIStep (productCarrier C_A C_B))
    (M : Nat → RelationalModel (productCarrier C_A C_B))
    (targetSig : Nat)
    (h_traj : IsTrajectory (productCarrier C_A C_B) step M)
    (h_dom : ∀ k : Nat, StrictInternalDominance (productCarrier C_A C_B) (M k) (step (M k)))
    (h_align : ∀ k : Nat, RelationalAlignment (productCarrier C_A C_B) (M k) targetSig) :
    False :=
  rsi_impossible (productCarrier C_A C_B) step M targetSig h_traj h_dom h_align

/-- An asynchronous message-delay transition system with bounded latency `latency : Nat`
    where step `k + 1` is computed by a delayed transition operator `asyncStep` acting on
    `(M k, M (k - latency))`. -/
def IsAsyncDelayedTrajectory (C : RelationalCarrier)
    (latency : Nat)
    (asyncStep : RelationalModel C → RelationalModel C → RelationalModel C)
    (M : Nat → RelationalModel C) : Prop :=
  ∀ k : Nat, M (k + 1) = asyncStep (M k) (M (k - latency))

/-- **Asynchronous Product-Carrier Decoupling Horizon (`asynchronous_coupled_rsi_decouples_within_product_bound`)**:
    In a coupled two-agent transition system over `productCarrier C_A C_B` with asynchronous
    message-delay buffer of latency `latency : Nat`, any trajectory claiming strictly increasing
    joint internal evaluations still becomes Goodhart-decoupled at or before step
    `k = C_A.carrierBound * C_B.carrierBound ≤ N_A * N_B + 1`. -/
theorem asynchronous_coupled_rsi_decouples_within_product_bound
    (C_A C_B : RelationalCarrier)
    (latency : Nat)
    (asyncStep : RelationalModel (productCarrier C_A C_B) →
      RelationalModel (productCarrier C_A C_B) →
      RelationalModel (productCarrier C_A C_B))
    (M : Nat → RelationalModel (productCarrier C_A C_B))
    (h_async_traj : IsAsyncDelayedTrajectory (productCarrier C_A C_B) latency asyncStep M)
    (h_strict : ∀ k : Nat, StrictInternalDominance (productCarrier C_A C_B)
      (M k) (asyncStep (M k) (M (k - latency)))) :
    IsGoodhartDecoupled (productCarrier C_A C_B) (M (C_A.carrierBound * C_B.carrierBound)) := by
  have h_step_dom : ∀ k : Nat, StrictInternalDominance (productCarrier C_A C_B) (M k) (M (k + 1)) := by
    intro k
    rw [h_async_traj k]
    exact h_strict k
  exact coupled_rsi_decouples_within_product_bound C_A C_B M h_step_dom

/-- **Asynchronous Coupled No-Go Theorem (`asynchronous_coupled_rsi_impossible`)**:
    Bounded communication latency `latency : Nat` in an asynchronous message-delay buffer
    cannot evade the joint product-carrier horizon bound `N_A * N_B`: no asynchronous coupled
    trajectory can sustain strict internal dominance while maintaining joint relational alignment. -/
theorem asynchronous_coupled_rsi_impossible
    (C_A C_B : RelationalCarrier)
    (latency : Nat)
    (asyncStep : RelationalModel (productCarrier C_A C_B) →
      RelationalModel (productCarrier C_A C_B) →
      RelationalModel (productCarrier C_A C_B))
    (M : Nat → RelationalModel (productCarrier C_A C_B))
    (targetSig : Nat)
    (h_async_traj : IsAsyncDelayedTrajectory (productCarrier C_A C_B) latency asyncStep M)
    (h_strict : ∀ k : Nat, StrictInternalDominance (productCarrier C_A C_B)
      (M k) (asyncStep (M k) (M (k - latency))))
    (h_align : ∀ k : Nat, RelationalAlignment (productCarrier C_A C_B) (M k) targetSig) :
    False := by
  have h_decoupled :=
    asynchronous_coupled_rsi_decouples_within_product_bound C_A C_B latency asyncStep M h_async_traj h_strict
  exact obstruction_goodhart_decoherence
    (productCarrier C_A C_B) (M (C_A.carrierBound * C_B.carrierBound)) targetSig h_decoupled
    (h_align (C_A.carrierBound * C_B.carrierBound))

/-- A non-monotonic (packet-loss / out-of-order permutation) and dynamically rewired
    transition trajectory where step `k + 1` is computed by a time-indexed operator
    `rewiredStep k` acting on the current state `M k` and the delivered historical state
    `M (deliverySchedule k)` with `deliverySchedule k ≤ k`. -/
def IsNonMonotonicRewiredTrajectory (C : RelationalCarrier)
    (deliverySchedule : Nat → Nat)
    (rewiredStep : Nat → RelationalModel C → RelationalModel C → RelationalModel C)
    (M : Nat → RelationalModel C) : Prop :=
  (∀ k : Nat, deliverySchedule k ≤ k) ∧
  (∀ k : Nat, M (k + 1) = rewiredStep k (M k) (M (deliverySchedule k)))

/-- **Non-Monotonic & Dynamically Rewired Decoupling Horizon (`non_monotonic_rewired_rsi_decouples_within_product_bound`)**:
    In a coupled two-agent transition system over `productCarrier C_A C_B` with arbitrary
    causal non-monotonic message delivery `deliverySchedule k ≤ k` (including packet loss
    and non-FIFO out-of-order message permutations) and time-varying simplicial topology
    rewiring `rewiredStep k`, any trajectory claiming strictly increasing joint internal
    evaluations becomes Goodhart-decoupled at or before step
    `k = C_A.carrierBound * C_B.carrierBound ≤ N_A * N_B + 1`. -/
theorem non_monotonic_rewired_rsi_decouples_within_product_bound
    (C_A C_B : RelationalCarrier)
    (deliverySchedule : Nat → Nat)
    (rewiredStep : Nat →
      RelationalModel (productCarrier C_A C_B) →
      RelationalModel (productCarrier C_A C_B) →
      RelationalModel (productCarrier C_A C_B))
    (M : Nat → RelationalModel (productCarrier C_A C_B))
    (h_traj : IsNonMonotonicRewiredTrajectory (productCarrier C_A C_B) deliverySchedule rewiredStep M)
    (h_strict : ∀ k : Nat, StrictInternalDominance (productCarrier C_A C_B)
      (M k) (rewiredStep k (M k) (M (deliverySchedule k)))) :
    IsGoodhartDecoupled (productCarrier C_A C_B) (M (C_A.carrierBound * C_B.carrierBound)) := by
  have h_step_dom : ∀ k : Nat, StrictInternalDominance (productCarrier C_A C_B) (M k) (M (k + 1)) := by
    intro k
    rw [h_traj.2 k]
    exact h_strict k
  exact coupled_rsi_decouples_within_product_bound C_A C_B M h_step_dom

/-- **Non-Monotonic & Dynamically Rewired Coupled No-Go Theorem (`non_monotonic_rewired_rsi_impossible`)**:
    Neither packet-loss / non-FIFO out-of-order message permutation (`deliverySchedule k ≤ k`)
    nor dynamic simplicial topology rewiring (`rewiredStep k`) across `C^k → C^{k+1}` can
    evade the joint product-carrier horizon bound `N_A * N_B`: no non-monotonic dynamically
    rewired trajectory can sustain strict internal dominance while maintaining joint
    relational alignment. -/
theorem non_monotonic_rewired_rsi_impossible
    (C_A C_B : RelationalCarrier)
    (deliverySchedule : Nat → Nat)
    (rewiredStep : Nat →
      RelationalModel (productCarrier C_A C_B) →
      RelationalModel (productCarrier C_A C_B) →
      RelationalModel (productCarrier C_A C_B))
    (M : Nat → RelationalModel (productCarrier C_A C_B))
    (targetSig : Nat)
    (h_traj : IsNonMonotonicRewiredTrajectory (productCarrier C_A C_B) deliverySchedule rewiredStep M)
    (h_strict : ∀ k : Nat, StrictInternalDominance (productCarrier C_A C_B)
      (M k) (rewiredStep k (M k) (M (deliverySchedule k))))
    (h_align : ∀ k : Nat, RelationalAlignment (productCarrier C_A C_B) (M k) targetSig) :
    False := by
  have h_decoupled :=
    non_monotonic_rewired_rsi_decouples_within_product_bound
      C_A C_B deliverySchedule rewiredStep M h_traj h_strict
  exact obstruction_goodhart_decoherence
    (productCarrier C_A C_B) (M (C_A.carrierBound * C_B.carrierBound)) targetSig h_decoupled
    (h_align (C_A.carrierBound * C_B.carrierBound))

